{
  "name": "crm-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/lib/distribution.test.ts src/lib/money.test.ts src/lib/kpi.test.ts src/lib/attendance.test.ts src/lib/dataBank.test.ts src/lib/quotaError.test.ts src/lib/pipelineStage.test.ts src/lib/profitDistribution.test.ts src/lib/kyc.test.ts src/lib/followUpKind.test.ts src/lib/managerMetrics.test.ts src/lib/attendancePolicy.test.ts src/lib/attendanceCalendar.test.ts src/lib/payroll.test.ts src/lib/officeExpenses.test.ts src/lib/assignTargets.test.ts src/lib/reportScope.test.ts src/lib/leadBuckets.test.ts src/lib/configError.test.ts",
    "check": "npm run typecheck && npm run test && npm run lint",
    "check-auth": "node --env-file=.env.local --experimental-strip-types scripts/check-auth.mts",
    "set-admin-role": "node --env-file=.env.local --experimental-strip-types scripts/set-admin-role.mts",
    "purge-demo-data": "node --env-file=.env.local --experimental-strip-types scripts/purge-demo-data.mts",
    "purge-all-data": "node --env-file=.env.local --experimental-strip-types scripts/purge-all-data.mts",
    "set-admin-key": "node scripts/set-admin-key.mjs",
    "diagnose:report": "node --env-file=.env.local --experimental-strip-types scripts/diagnose-report.mts",
    "diagnose": "node --env-file=.env.local --experimental-strip-types scripts/diagnose-firestore.mts",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "deploy:rules:rest": "node scripts/deploy-rules-rest.mjs",
    "check:indexes": "node scripts/check-indexes.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project leadway-rules-test 'node --test scripts/rules.test.mjs'"
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "firebase-admin": "^14.2.0",
    "gsap": "^3.13.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "overrides": {
    "jose": "^4.15.9"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
