# Copy to .env.local (git-ignored) for local development. In production every
# value below lives in Vercel Environment Variables.

# ---------------------------------------------------------------------------
# Firebase web config — public by design, safe to expose in the browser bundle.
# Get these via: firebase apps:sdkconfig web  (or Firebase console -> Project settings)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Point local dev at the Firebase Emulator Suite instead of the live project.
NEXT_PUBLIC_USE_EMULATORS=false

# ---------------------------------------------------------------------------
# DEMO MODE — run the whole app with in-memory sample data and no backend.
#
# Set to true and every screen works immediately: sign in with the demo
# accounts, browse leads, log follow-ups, record deals. No Firebase is loaded
# at all, nothing is saved, and an amber banner marks every page.
#
# Useful for showing the product before a Firebase project is configured.
# Leave false (or unset) to use the real thing.
#
# Demo accounts, password Demo12345:
#   admin@crm.com   ayesha@crm.com   bilal@crm.com   sana@crm.com
# ---------------------------------------------------------------------------
NEXT_PUBLIC_DEMO_MODE=demo

# ---------------------------------------------------------------------------
# Firebase Admin SDK — REQUIRED. Without these every privileged write fails.
#
# Firebase console -> Project settings -> Service accounts -> Generate new
# private key. Keep the downloaded JSON out of the repo.
#
# FIREBASE_PRIVATE_KEY must keep its newlines. In a .env file wrap the whole
# value in double quotes and leave the \n sequences literal:
#   FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# When pasting into the Vercel dashboard, paste the real multi-line key instead.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Scheduler — REQUIRED. Guards /api/cron/process-deadlines, which runs the
# 5-minute and 10-minute SLA windows. Vercel Cron sends this automatically as
# `Authorization: Bearer $CRON_SECRET` once the variable is set. The endpoint
# refuses to run without it.
#
# Generate one with: openssl rand -hex 32
# ---------------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------------
# Meta Lead Ads — REQUIRED for real lead intake.
#
# The leadgen webhook carries only an ID; the customer's name, phone and email
# have to be fetched from the Graph API with a token that holds leads_retrieval.
# Without META_PAGE_ACCESS_TOKEN, leads arrive with no contact details.
#
# Ask whoever administers the Meta Business Manager for these. Note that
# leads_retrieval needs Advanced Access, which requires business verification —
# start that process early.
# ---------------------------------------------------------------------------

# App Secret from the Meta app. Verifies the X-Hub-Signature-256 header on every
# delivery. The webhook rejects all traffic when this is unset.
META_APP_SECRET=

# Any string you choose. Must match exactly what you enter in the Meta app's
# webhook configuration screen.
META_WEBHOOK_VERIFY_TOKEN=

# Long-lived Page Access Token, or a System User token, with:
#   leads_retrieval, pages_show_list, pages_read_engagement, pages_manage_metadata
META_PAGE_ACCESS_TOKEN=

# Optional. Graph API version to call. Defaults to v21.0.
META_GRAPH_VERSION=

# Optional. Only needed to resolve an ad ID up to its campaign name for
# reporting (FR-25). Requires the ads_read permission.
META_AD_ACCOUNT_ID=

# ---------------------------------------------------------------------------
# WhatsApp Business API — Phase 2, leave unset.
#
# BR-11 keeps WhatsApp as manual wa.me click-to-chat in Phase 1. The send-side
# seam exists and is switched off. See docs/integrations/whatsapp-placeholder.md
# before filling these in — the request shape differs between Meta's own Cloud
# API and a BSP such as 360dialog or Twilio.
# ---------------------------------------------------------------------------
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# ---------------------------------------------------------------------------
# Local tooling only — never needed in production.
# ---------------------------------------------------------------------------
# VERCEL_TOKEN=
# GITHUB_TOKEN=
